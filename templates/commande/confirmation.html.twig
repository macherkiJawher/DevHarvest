{# templates/commande/confirmation.html.twig #}

{% extends 'client.html.twig' %}

{% block title %}Confirmation de Commande{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="card shadow-sm">
            <div class="card-header">
                <h3 class="card-title">Confirmation de votre commande</h3>
            </div>
            <div class="card-body">
                <p>Merci pour votre commande ! Voici les détails :</p>
                <ul>
                    <li><strong>ID de la commande : </strong>{{ commande.id }}</li>
                    <li><strong>Date de commande : </strong>{{ commande.datecommande|date('d/m/Y H:i') }}</li>
                    <li><strong>Total : </strong>{{ commande.total }} €</li>
                </ul>

                <h4 class="mt-4">Entrez vos coordonnées</h4>
                {{ form_start(form, {'attr': {'class': 'mt-3'}}) }}
                    <div class="mb-3">
                        <label for="{{ form.nom.vars.id }}" class="form-label"><strong>Nom :</strong></label>
                        {{ form_widget(form.nom) }}
                    </div>
                    <div class="mb-3">
                        <label for="{{ form.prenom.vars.id }}" class="form-label"><strong>Prénom :</strong></label>
                        {{ form_widget(form.prenom) }}
                    </div>
                    <div class="mb-3">
                        <label for="{{ form.adresse.vars.id }}" class="form-label"><strong>Adresse :</strong></label>
                        {{ form_widget(form.adresse) }}
                    </div>
                    <div class="mb-3">
                        <label for="{{ form.telephone.vars.id }}" class="form-label"><strong>Téléphone :</strong></label>
                        {{ form_widget(form.telephone) }}
                    </div>
                    <div class="mb-3">
                        <label for="{{ form.email.vars.id }}" class="form-label"><strong>Email :</strong></label>
                        {{ form_widget(form.email) }}
                    </div>
                    {# Le bouton submit est automatiquement généré par Symfony, donc pas besoin de celui-ci #}
                {{ form_end(form) }}
                
                <a href="{{ path('app_home') }}" class="btn btn-primary mt-3">Retour à l'accueil</a>
            </div>
        </div>
    </div>
{% endblock %}
