{% extends 'admin.html.twig' %}

{% block title %}Créer une Nouvelle Grange{% endblock %}

{% block content %}
<div class="container mt-5 d-flex justify-content-center">
    <div class="card shadow-lg border-0" style="width: 600px; border-radius: 12px;">
        <div class="card-header bg-dark text-white text-center">
            <h4>Créer une Nouvelle Grange</h4>
        </div>
        <div class="card-body bg-light">
            {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

            {% for field in form %}
                <div class="mb-3">
                    {{ form_label(field, null, {'label_attr': {'class': 'fw-bold text-secondary'}}) }}
                    {{ form_widget(field, {'attr': {'class': 'form-control'}}) }}
                    <div class="text-danger small">{{ form_errors(field) }}</div>
                </div>
            {% endfor %}

            <div class="d-flex justify-content-between mt-4">
                <a href="{{ path('admin_grange_index') }}" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left"></i> Retour
                </a>
                <button type="submit" class="btn btn-success">
                    <i class="fas fa-plus"></i> Ajouter
                </button>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
