{% extends 'client.html.twig' %}

{% block title %}Modifier la Zone{% endblock %}

{% block body %}
<div class="container mt-5">
    <!-- Section Titre -->
    <div class="row">
        <div class="col-12 text-center mb-4">
            <h1 class="text-warning">Modifier la Zone</h1>
            <p class="text-muted">Mettez à jour les informations de la zone ci-dessous.</p>
        </div>
    </div>

    <!-- Section Formulaire dans une carte -->
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-warning">
                <div class="card-header bg-warning text-white text-center">
                    <h4 class="mb-0">Édition de la Zone</h4>
                </div>
                <div class="card-body">
                    {{ include('zone/_form.html.twig', {'button_label': 'Modifier'}) }}
                    
                    <!-- Mapbox Section -->
                    <div class="mb-3">
                        <label class="form-label">Localisation</label>
                        <div id="map" class="mb-2" style="height: 400px; border-radius: 8px; overflow: hidden;"></div>
                        <input type="text" id="zone_localisation_zone" name="zone[localisation_zone]" class="form-control" value="{{ form.localisation_zone.vars.value }}">
                    </div>
                    
                    <!-- Bouton Modifier sous la carte -->
                    <div class="text-center">
                        <button type="submit" class="btn btn-warning">Modifier</button>
                    </div>
                </div>
                <div class="card-footer text-center">
                    <a href="{{ path('app_zone_index') }}" class="btn btn-outline-warning px-4">Retour</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Section Suppression -->
    <div class="row justify-content-center mt-4">
        <div class="col-md-8">
            <div class="card border-danger shadow-sm">
                <div class="card-header bg-danger text-white text-center">
                    <h4 class="mb-0">Supprimer la Zone</h4>
                </div>
                <div class="card-body text-center">
                    <p class="text-muted">Cette action est irréversible. Veuillez confirmer votre choix.</p>
                    <p class="text-danger font-weight-bold">Attention : Si cette zone contient une ou plusieurs granges, leur suppression pourrait entraîner une perte de données.</p>
                    {{ include('zone/_delete_form.html.twig') }}
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Mapbox JavaScript -->
<script src="https://api.mapbox.com/mapbox-gl-js/v2.3.1/mapbox-gl.js"></script>
<script>
    mapboxgl.accessToken = '{{ mapbox_api_key }}';
    var coordinates = "{{ form.localisation_zone.vars.value }}".split(",");
    var lng = parseFloat(coordinates[0]) || 2.2945;
    var lat = parseFloat(coordinates[1]) || 48.8584;
    
    var map = new mapboxgl.Map({
        container: 'map',
        style: 'mapbox://styles/mapbox/streets-v11',
        center: [lng, lat],
        zoom: 13
    });

    var marker = new mapboxgl.Marker()
        .setLngLat([lng, lat])
        .addTo(map);

    map.on('click', function (e) {
        var lngLat = e.lngLat;
        marker.setLngLat(lngLat);
        document.getElementById('zone_localisation_zone').value = lngLat.lng + ',' + lngLat.lat;
    });
</script>
{% endblock %}
