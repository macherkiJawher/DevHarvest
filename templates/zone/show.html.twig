{% extends 'client.html.twig' %}

{% block title %}Détails de la Zone{% endblock %}

{% block body %}
<div class="container mt-5">
    <!-- Section Détails de la Zone -->
    <h1 class="text-warning text-center">{{ zone.nomZone }}</h1>
    <p><strong>Superficie :</strong> {{ zone.superficieZone }} m²</p>
    <p><strong>Localisation :</strong> {{ zone.localisationZone }}</p>

    <!-- Carte Mapbox -->
    <div class="mb-4">
        <h3 class="text-center">Localisation</h3>
        <div id="map" style="height: 400px; border-radius: 8px;"></div>
    </div>

    <!-- Section Liste des Granges -->
    <h3 class="mt-4 text-center">Granges associées</h3>
    {% if granges is empty %}
        <p class="text-muted text-center">Aucune grange trouvée pour cette zone.</p>
    {% else %}
        <div class="row">
            {% for grange in granges %}
                <div class="col-md-4">
                    <div class="card mb-3 shadow">
                        {% if grange.image %}
                            <img src="{{ asset('uploads/' ~ grange.image) }}" class="card-img-top" alt="Image de la grange">
                        {% else %}
                            <img src="{{ asset('images/default-barn.jpg') }}" class="card-img-top" alt="Image par défaut">
                        {% endif %}
                        <div class="card-body">
                            <h5 class="card-title">{{ grange.typeGrange }}</h5>
                            <p class="card-text"><strong>Capacité :</strong> {{ grange.capacite }}</p>
                            {% if grange.productivite is not null %}
                                <p class="card-text"><strong>Productivité :</strong> {{ grange.productivite }} unités</p>
                            {% endif %}
                            <a href="{{ path('app_grange_show', {'id': grange.id}) }}" class="btn btn-sm btn-info">Voir plus</a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}

    <a href="{{ path('app_zone_index') }}" class="btn btn-outline-warning mt-3">Retour</a>
</div>

<!-- Mapbox JavaScript -->
<script src="https://api.mapbox.com/mapbox-gl-js/v2.3.1/mapbox-gl.js"></script>
<script>
    mapboxgl.accessToken = '{{ mapbox_api_key }}';

    var coordinates = "{{ zone.localisationZone }}".split(",");
    var lng = parseFloat(coordinates[0]) || 2.2945; // Valeur par défaut (Paris)
    var lat = parseFloat(coordinates[1]) || 48.8584;

    var map = new mapboxgl.Map({
        container: 'map',
        style: 'mapbox://styles/mapbox/streets-v11',
        center: [lng, lat],
        zoom: 13
    });

    new mapboxgl.Marker()
        .setLngLat([lng, lat])
        .addTo(map);
</script>

{% endblock %}
