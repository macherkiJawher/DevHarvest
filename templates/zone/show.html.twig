{% extends 'client.html.twig' %}

{% block title %}Détails de la zone - {{ zone.nomZone }}{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h1>Détails de la zone : {{ zone.nomZone }}</h1>

        <div class="card">
            <div class="card-body">
                <p><strong>Nom de la zone :</strong> {{ zone.nomZone }}</p>
                <p><strong>Superficie :</strong> {{ zone.superficieZone }} m²</p>
                <p><strong>Localisation :</strong> {{ zone.localisationZone }}</p>

                <!-- Carte Mapbox -->
                <div id="map" style="height: 400px;"></div>  
            </div>
        </div>

        <a href="{{ path('app_zone_index') }}" class="btn btn-secondary mt-3">Retour</a>
    </div>

    <!-- Mapbox JavaScript -->
    <script src="https://api.mapbox.com/mapbox-gl-js/v2.9.1/mapbox-gl.js"></script>
    <link href="https://api.mapbox.com/mapbox-gl-js/v2.9.1/mapbox-gl.css" rel="stylesheet" />
    
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            var localisation = "{{ zone.localisationZone }}";

            if (localisation.includes(',')) {
                var coordinates = localisation.split(',').map(parseFloat);
                var longitude = coordinates[0];
                var latitude = coordinates[1];

                if (!isNaN(longitude) && !isNaN(latitude)) {
                    mapboxgl.accessToken = '{{ mapbox_api_key }}';

                    var map = new mapboxgl.Map({
                        container: 'map',
                        style: 'mapbox://styles/mapbox/streets-v11',
                        center: [longitude, latitude], // Longitude en premier !
                        zoom: 13
                    });

                    new mapboxgl.Marker()
                        .setLngLat([longitude, latitude])
                        .addTo(map);
                } else {
                    document.getElementById('map').innerHTML = "<p class='text-danger'>Localisation invalide.</p>";
                }
            } else {
                document.getElementById('map').innerHTML = "<p class='text-danger'>Aucune localisation disponible.</p>";
            }
        });
    </script>
{% endblock %}
