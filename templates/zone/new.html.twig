{% extends 'client.html.twig' %}

{% block title %}Créer une zone{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h1 class="mb-4 text-center">Créer une zone</h1>

        <div class="card shadow-sm">
            <div class="card-body">
                {{ form_start(form) }}
                
                <div class="mb-3">
                    {{ form_label(form.nom_zone, 'Nom de la zone', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.nom_zone, {'attr': {'class': 'form-control' ~ (form.nom_zone.vars.errors|length > 0 ? ' is-invalid' : '')}}) }}
                    {{ form_errors(form.nom_zone) }}
                </div>
                
                <div class="mb-3">
                    {{ form_label(form.superficie_zone, 'Superficie (m²)', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.superficie_zone, {'attr': {'class': 'form-control' ~ (form.superficie_zone.vars.errors|length > 0 ? ' is-invalid' : ''), 'step': 'any'}}) }}
                    {{ form_errors(form.superficie_zone) }}
                </div>
                
                <div class="mb-3">
                    {{ form_label(form.localisation_zone, 'Localisation', {'label_attr': {'class': 'form-label'}}) }}
                    <div id="map" class="mb-2" style="height: 400px; border-radius: 8px; overflow: hidden;"></div>
                    {{ form_widget(form.localisation_zone, {'attr': {'class': 'form-control' ~ (form.localisation_zone.vars.errors|length > 0 ? ' is-invalid' : '')}}) }}
                    {{ form_errors(form.localisation_zone) }}
                </div>
                
                <div class="mb-3">
                    {{ form_label(form.image, 'Image', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.image, {'attr': {'class': 'form-control-file'}}) }}
                    {{ form_errors(form.image) }}
                </div>
                
                <div class="text-center">
                    <button type="submit" class="btn btn-success">Créer</button>
                </div>
                
                {{ form_end(form) }}
            </div>
        </div>
        
        <div class="text-center mt-4">
            <a href="{{ path('app_zone_index') }}" class="btn btn-secondary">Retour</a>
        </div>
    </div>

    <!-- Mapbox JavaScript -->
    <script src="https://api.mapbox.com/mapbox-gl-js/v2.3.1/mapbox-gl.js"></script>
    <script>
        mapboxgl.accessToken = '{{ mapbox_api_key }}';
        var map = new mapboxgl.Map({
            container: 'map',
            style: 'mapbox://styles/mapbox/streets-v11',
            center: [2.2945, 48.8584],
            zoom: 13
        });

        var marker = new mapboxgl.Marker()
            .setLngLat([2.2945, 48.8584])
            .addTo(map);

        map.on('click', function (e) {
            var lngLat = e.lngLat;
            marker.setLngLat(lngLat);
            document.getElementById('zone_localisation_zone').value = lngLat.lng + ',' + lngLat.lat;
        });
    </script>
{% endblock %}
