{% extends 'client.html.twig' %}

{% block title %}Zone Index{% endblock %}

{% block body %}
    <!-- Start Zones Section -->
    <div class="zone-box py-5">
        <div class="container">
            <!-- Title Section -->
            <div class="row mb-4">
                <div class="col-lg-12 text-center">
                    <h1 class="display-4">Les Zones</h1>
                </div>
            </div>

            <!-- Button to Create New Zone -->
            <div class="row mb-4">
                <div class="col-lg-12 text-center">
                    <button onclick="window.location.href='{{ path('app_zone_new') }}'" class="btn btn-primary">
                        Créer une nouvelle zone
                    </button>
                </div>
            </div>

            <!-- Display Zones -->
            <div class="row">
                {% for zone in zones %}
                    <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
                        <div class="zone-single card shadow-sm">
                            <div class="box-img-hover">
                                {% if zone.image %}
                                    <img class="card-img-top" src="{{ asset('uploads/zones/' ~ zone.image) }}" alt="{{ zone.nomZone }}">
                                {% else %}
                                    <img class="card-img-top" src="{{ asset('client/images/zone-placeholder.jpg') }}" alt="Default Zone Image">
                                {% endif %}
                            </div>
                            <div class="card-body">
                                <h5 class="card-title">{{ zone.nomZone }}</h5>
                                <p class="card-text"><strong>Superficie:</strong> {{ zone.superficieZone }} m²</p>
                                <p class="card-text"><strong>Localisation:</strong> {{ zone.localisationZone }}</p>
                            </div>
                            <div class="card-footer text-center">
                                <a href="{{ path('app_zone_show', {'id': zone.id}) }}" class="btn btn-info" data-toggle="tooltip" data-placement="top" title="Voir Détails">
                                    <i class="fas fa-eye"></i> Détails
                                </a>
                                <a href="{{ path('app_zone_edit', {'id': zone.id}) }}" class="btn btn-warning" data-toggle="tooltip" data-placement="top" title="Modifier">
                                    <i class="fas fa-edit"></i> Modifier
                                </a>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="col-12 text-center">
                        <p>Aucune zone trouvée.</p>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
    <!-- End Zones Section -->
{% endblock %}
