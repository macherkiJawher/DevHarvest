{% extends 'admin.html.twig' %}

{% block title %}Modifier le Produit{% endblock %}

{% block content %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-warning text-white text-center py-3">
                    <h3 class="mb-0"><i class="fas fa-edit"></i> Modifier le Produit</h3>
                </div>
                <div class="card-body p-4 bg-light">
                    <!-- Formulaire de modification -->
                    {{ form_start(form) }}
                        <div class="mb-4">
                            <!-- Ajout de widgets pour les champs de formulaire -->
                            {{ form_widget(form) }}
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4">
                            <!-- Bouton Retour à la liste des produits -->
                            <a href="{{ path('admin_produits') }}" class="btn btn-outline-secondary px-4 py-2 shadow-sm rounded-pill">
                                <i class="fas fa-arrow-left"></i> Retour à la liste
                            </a>

                            <!-- Bouton Enregistrer les modifications -->
                            <button type="submit" class="btn btn-success px-4 py-2 shadow-sm rounded-pill">
                                <i class="fas fa-save"></i> Enregistrer les modifications
                            </button>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
