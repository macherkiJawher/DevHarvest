{% extends 'admin.html.twig' %}

{% block title %}Gestion des Produits{% endblock %}

{% block content %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow border-0">
                <div class="card-header bg-dark text-white text-center">
                    <h3 class="mb-0">Gestion des Produits</h3>
                </div>
                <div class="card-body bg-light">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5 class="mb-0 text-secondary">Liste des Produits</h5>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-striped table-hover align-middle">
                            <thead class="bg-secondary text-white text-center">
                                <tr>
                                    <th>ID</th>
                                    <th>Nom</th>
                                    <th>Date d'ajout</th>
                                    <th>Prix Unitaire</th>
                                    <th>Quantité Stock</th>
                                    <th>Agriculteur</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for produit in produits %}
                                <tr>
                                    <td class="text-center text-dark fw-bold">{{ produit.id }}</td>
                                    <td class="text-dark">{{ produit.nom }}</td>
                                    <td class="text-center">{{ produit.dateAjout|date('d/m/Y') }}</td>
                                    <td class="text-center">{{ produit.prixunitaire }} TND</td>
                                    <td class="text-center">{{ produit.quantitestock }}</td>
                                    <td class="text-center">{{ produit.agriculteur.username }}</td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <!-- Voir le produit -->
                                            <a href="{{ path('admin_produit_afficher', {'id': produit.id}) }}" class="btn btn-primary btn-sm shadow-sm rounded-pill px-4 py-2">
                                                <i class="fas fa-eye"></i> Voir
                                            </a>

                                            <!-- Modifier le produit -->
                                            <a href="{{ path('admin_produit_modifier', {'id': produit.id}) }}" class="btn btn-warning btn-sm shadow-sm rounded-pill px-4 py-2">
                                                <i class="fas fa-edit"></i> Modifier
                                            </a>

                                            <!-- Supprimer le produit -->
                                            <form method="post" action="{{ path('admin_produit_supprimer', {'id': produit.id}) }}" class="d-inline"
                                                  onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce produit ?');">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ produit.id) }}">
                                                <button type="submit" class="btn btn-danger btn-sm shadow-sm rounded-pill px-4 py-2">
                                                    <i class="fas fa-trash-alt"></i> Supprimer
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td colspan="7" class="text-center text-muted">Aucun produit trouvé.</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="text-center mt-4">
                <a href="{{ path('admin_dashboard') }}" class="btn btn-outline-secondary rounded-pill px-4 py-2 shadow-sm">
                    <i class="fas fa-arrow-left"></i> Retour au tableau de bord
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}