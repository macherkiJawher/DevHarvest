{% extends 'admin.html.twig' %}

{% block title %}Détails du Produit{% endblock %}

{% block content %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-dark text-white text-center py-4">
                    <h3 class="mb-0"><i class="fas fa-box"></i> Détails du Produit</h3>
                </div>
                <div class="card-body p-5 bg-light">
                    <div class="row align-items-center">
                        <div class="col-md-5 text-center">
                            <img src="{{ produit.getImageUrl() }}" alt="{{ produit.nom }}" 
                                 class="img-fluid rounded shadow-sm" style="max-width: 100%; height: auto;">
                        </div>
                        
                        <div class="col-md-7">
                            <h4 class="text-primary">{{ produit.nom }}</h4>
                            <hr>
                            <p><strong><i class="fas fa-calendar-alt"></i> Date d'ajout :</strong> {{ produit.dateAjout|date('d/m/Y') }}</p>
                            <p><strong><i class="fas fa-tag"></i> Prix :</strong> <span class="badge bg-success">{{ produit.prixUnitaire }} TND</span></p>
                            <p><strong><i class="fas fa-boxes"></i> Quantité en stock :</strong> {{ produit.quantiteStock }}</p>
                            <p><strong><i class="fas fa-user"></i> Ajouté par :</strong> {{ produit.agriculteur.username }}</p>
                        </div>
                    </div>

                    <div class="text-center mt-4">
                        <a href="{{ path('admin_produits') }}" class="btn btn-outline-dark px-4">
                            <i class="fas fa-arrow-left"></i> Retour
                        </a>
                    </div>

                    <!-- Séparation des boutons -->
                    <div class="mt-4 d-flex justify-content-between">
                        <a href="{{ path('admin_produit_modifier', {'id': produit.id}) }}" class="btn btn-warning px-4">
                            <i class="fas fa-edit"></i> Modifier
                        </a>

                        <form action="{{ path('admin_produit_supprimer', {'id': produit.id}) }}" method="post" class="d-inline" 
                              onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce produit ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ produit.id) }}">
                            <button type="submit" class="btn btn-danger px-4">
                                <i class="fas fa-trash-alt"></i> Supprimer
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
