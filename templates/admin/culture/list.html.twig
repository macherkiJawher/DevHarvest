{% extends 'admin.html.twig' %}

{% block title %}Gestion des Cultures{% endblock %}

{% block content %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow border-0">
                <div class="card-header bg-dark text-white text-center">
                    <h3 class="mb-0">Gestion des Cultures</h3>
                </div>
                <div class="card-body bg-light">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5 class="mb-0 text-secondary">Liste des Cultures</h5>
                        <a href="{{ path('admin_culture_new') }}" class="btn btn-outline-success">
                            <i class="fas fa-plus mr-2"></i> Ajouter une Culture
                        </a>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-striped table-hover align-middle">
                            <thead class="bg-secondary text-white text-center">
                                <tr>
                                    <th>Nom</th>
                                    <th>Description</th>
                                    <th>Date de Plantation</th>
                                    <th>Date de Récolte</th>
                                    <th>Saison</th> <!-- Ajouté Saison -->
                                    <th>Quantité</th> <!-- Ajouté Quantité -->
                                    <th>Image</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for culture in cultures %}
                                <tr>
                                    <td class="text-center text-dark fw-bold">{{ culture.nom }}</td>
                                    <td class="text-dark">{{ culture.description }}</td>
                                    <td class="text-center">{{ culture.datePlantation ? culture.datePlantation|date('d/m/Y') : 'N/A' }}</td>
                                    <td class="text-center">{{ culture.dateRecolte ? culture.dateRecolte|date('d/m/Y') : 'N/A' }}</td>
                                    <td class="text-center">{{ culture.saison ?? 'Non spécifié' }}</td> <!-- Affichage Saison -->
                                    <td class="text-center">{{ culture.quantite ?? 'Non spécifié' }}</td> <!-- Affichage Quantité -->
                                    <td class="text-center">
                                        {% if culture.image %}
                                            <img src="{{ asset('uploads/images/' ~ culture.image) }}" alt="{{ culture.nom }}" class="img-thumbnail" width="50">
                                        {% else %}
                                            Aucune image
                                        {% endif %}
                                    </td>
                                    <td class="text-center">
    <div class="btn-group" role="group">
        <a href="{{ path('admin_culture_edit', {'id': culture.id}) }}" class="btn btn-outline-primary btn-sm mr-2">
            <i class="fas fa-edit mr-2"></i> Modifier
        </a>
        <form method="post" action="{{ path('admin_culture_delete', {'id': culture.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette culture ?');" class="d-inline">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ culture.id) }}">
            <button class="btn btn-outline-danger btn-sm ml-2">
                <i class="fas fa-trash-alt mr-2"></i> Supprimer
            </button>
        </form>
    </div>
</td>

                                </tr>
                                {% else %}
                                <tr>
                                    <td colspan="8" class="text-center text-muted">Aucune culture trouvée.</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="text-center mt-4">
                <a href="{{ path('admin_dashboard') }}" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left mr-2"></i> Retour au tableau de bord
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
