{% extends 'client.html.twig' %}

{% block title %}Réponse Automatique - {{ post.titre }}{% endblock %}

{% block body %}
    <div class="container mt-4" style="max-width: 800px;">
        <h1>Réponse Automatique pour "{{ post.titre }}"</h1>
        
        <div class="post-card shadow-sm p-3 bg-white rounded">
            <h3>Contenu original</h3>
            <p class="text-muted">{{ post.contenu }}</p>
            {% if post.image %}
                <div class="text-center mb-3">
                    <img src="{{ asset('uploads/posts/' ~ post.image) }}" alt="Image du post" class="img-fluid img-custom rounded">
                </div>
            {% endif %}
        </div>

        <div class="mt-4 post-card shadow-sm p-3 bg-white rounded">
            <h3>Réponse générée par IA</h3>
            <p>{{ autoResponse|raw }}</p>
        </div>

        <div class="mt-3">
            <a href="{{ path('post_view', {'id': post.id}) }}" class="btn btn-secondary">⬅ Retour au post</a>
        </div>
    </div>
{% endblock %}