{% extends 'client.html.twig' %}

{% block title %}Liste des parcelles{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h1 class="text-center text-success mb-4">🌿 Liste des Parcelles</h1>
        <div class="d-flex justify-content-center mb-4">
            <a href="{{ path('parcelle_new') }}" class="btn btn-success btn-lg shadow-sm">
                <i class="fas fa-plus"></i> Ajouter une nouvelle parcelle
            </a>
        </div>

        <div class="row row-cols-1 row-cols-md-3 g-4">
            {% for parcelle in parcelles %}
                <div class="col">
                    <div class="card shadow-lg rounded-3">
                        
                        {% if parcelle.image %}
                            <img src="{{ asset('uploads/parcelles/' ~ parcelle.image) }}" class="card-img-top" alt="{{ parcelle.zone }}">
                        {% else %}
                            <img src="{{ asset('images/default-parcelle.jpg') }}" class="card-img-top" alt="Image non disponible">
                        {% endif %}

                        <div class="card-body d-flex justify-content-between align-items-center">
                            <h5 class="card-title mb-0 text-dark" style="font-size: 1.25rem;">{{ parcelle.zone }}</h5>
                            <div>
                                <a href="{{ path('parcelle_show', {'id': parcelle.id}) }}" class="btn btn-primary btn-sm shadow-sm">Voir plus</a>
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <p class="text-center text-muted">Aucune parcelle disponible.</p>
            {% endfor %}
        </div>

        <!-- Pagination -->
        <div class="d-flex justify-content-center mt-4">
            {{ knp_pagination_render(parcelles) }}
        </div>
    </div>

    <script>
        function confirmDelete(parcelleId) {
            const modal = new bootstrap.Modal(document.getElementById('deleteConfirmModal'));
            const form = document.getElementById('deleteForm');
            form.action = "/parcelle/" + parcelleId;
            document.getElementById('csrfToken').value = "{{ csrf_token('delete') }}";
            modal.show();
        }
    </script>

    <style>
        .card {
            border-radius: 12px;
            overflow: hidden;
            transition: transform 0.3s ease-in-out, box-shadow 0.3s ease-in-out;
        }

        .card:hover {
            transform: scale(1.05);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        }

        .card-img-top {
            height: 200px;
            object-fit: cover;
            border-bottom: 1px solid #eee;
        }

        .card-body {
            padding: 20px;
            background-color: #f9f9f9;
        }

        .btn-sm {
            padding: 6px 15px;
            font-size: 14px;
            border-radius: 5px;
            box-shadow: 0 3px 6px rgba(0, 0, 0, 0.1);
            transition: all 0.3s;
        }

        .btn-sm:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 10px rgba(0, 0, 0, 0.2);
        }

        .text-muted {
            font-size: 1.1rem;
            font-weight: 400;
        }
    </style>
{% endblock %}
