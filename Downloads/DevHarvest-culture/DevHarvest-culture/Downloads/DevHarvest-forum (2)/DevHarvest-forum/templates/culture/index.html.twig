{% extends 'client.html.twig' %}

{% block title %}Liste des Cultures{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h1 class="text-center text-success mb-4">🌿 Liste des Cultures</h1>

        <div class="text-center mb-4">
            <a href="{{ path('culture_new') }}" class="btn btn-success btn-lg shadow">
                <i class="fas fa-plus"></i> Ajouter une nouvelle culture
            </a>
        </div>

        <div class="row">
            {% for culture in cultures %}
                <div class="col-md-4 mb-4">
                    <div class="card shadow-lg border-0">
                        <div class="image-container">
                            {% if culture.image %}
                                <img src="{{ asset('uploads/images/' ~ culture.image) }}" class="card-img-top" alt="{{ culture.nom }}">
                            {% else %}
                                <img src="{{ asset('images/default.jpg') }}" class="card-img-top" alt="Image par défaut">
                            {% endif %}
                        </div>
                        <div class="card-body text-center">
                            <h5 class="card-title">
                                <a href="{{ path('culture_show', {'id': culture.id}) }}" class="text-dark fw-bold">{{ culture.nom }}</a>
                            </h5>
                            <p class="text-muted">{{ culture.description|slice(0, 50) ~ '...' }}</p>

                            <div class="culture-info mt-3">
                                <p><strong>🌱 Plantation :</strong> {{ culture.datePlantation ? culture.datePlantation|date('d/m/Y') : 'Non définie' }}</p>
                                <p><strong>🌾 Récolte :</strong> {{ culture.dateRecolte ? culture.dateRecolte|date('d/m/Y') : 'Non définie' }}</p>
                                <p><strong>📦 Quantité :</strong> <span class="badge bg-light text-success">{{ culture.quantite }} KG</span></p>

                                <p><strong>🍂 Saison :</strong> <span class="badge bg-light text-warning">{{ culture.saison }}</span></p>

                            </div>

                            <hr>
<div class="d-flex justify-content-center">
    <a href="{{ path('culture_show', {'id': culture.id}) }}" class="btn btn-info shadow-sm custom-btn-spacing">
        <i class="fas fa-eye"></i> Voir
    </a>
    <a href="{{ path('culture_edit', {'id': culture.id}) }}" class="btn btn-warning shadow-sm custom-btn-spacing">
        <i class="fas fa-edit"></i> Modifier
    </a>
    <form method="post" action="{{ path('culture_delete', {'id': culture.id}) }}" onsubmit="return confirm('Voulez-vous vraiment supprimer cette culture ?');">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ culture.id) }}">
        <button class="btn btn-danger shadow-sm custom-btn-spacing" type="submit">
            <i class="fas fa-trash-alt"></i> Supprimer
        </button>
    </form>
</div>



                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12 text-center">
                    <p class="text-muted">Aucune culture enregistrée.</p>
                </div>
            {% endfor %}
        </div>
    </div>

    <style>
        body {
            background-color: #f8f9fa;
        }

        .card {
            border-radius: 12px;
            overflow: hidden;
            transition: transform 0.2s ease-in-out;
        }

        .card:hover {
            transform: scale(1.02);
        }

        .image-container {
            height: 200px;
            overflow: hidden;
        }

        .card-img-top {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .culture-info p {
            margin-bottom: 5px;
            font-size: 0.95rem;
        }

        .badge {
            font-size: 0.9rem;
            padding: 6px 10px;
            border-radius: 8px;
        }

        .btn {
            font-size: 0.9rem;
            padding: 8px 12px;
            border-radius: 8px;
            transition: all 0.3s ease-in-out;
        }

        .btn:hover {
            transform: translateY(-2px);
        }

        .btn-lg {
            padding: 12px 18px;
            font-size: 1.1rem;
        }
    .custom-btn-spacing {
        margin-right: 20px; /* Espacement de 20px entre les boutons */
    }

    </style>
{% endblock %}
