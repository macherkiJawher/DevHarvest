{% extends 'client.html.twig' %}

{% block title %}Détails de la culture - {{ culture.nom }}{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h1 class="text-success text-center mb-4">{{ culture.nom }}</h1>

        <div class="row">
            <!-- Image de la culture -->
            <div class="col-md-6 text-center mb-4 mb-md-0">
                {% if culture.image %}
                    <img src="{{ asset('uploads/images/' ~ culture.image) }}" alt="{{ culture.nom }}" class="img-fluid rounded-3 shadow-sm" style="max-height: 300px; object-fit: cover;">
                {% else %}
                    <p>Aucune image disponible.</p>
                {% endif %}
            </div>

            <!-- Détails de la culture -->
            <div class="col-md-6">
                <div class="card shadow-sm mb-4">
                    <div class="card-body">
                        <h5 class="card-title">Détails de la culture</h5>
                        <p><strong>Description :</strong> {{ culture.description }}</p>
                        <p><strong>Date de plantation :</strong> {{ culture.datePlantation|date('d/m/Y') }}</p>
                        <p><strong>Date de récolte :</strong> {{ culture.dateRecolte|date('d/m/Y') }}</p>
                        <p><strong>Quantité :</strong> {{ culture.quantite }} unités</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Boutons d'action -->
        <div class="text-center mt-4">
            <a href="{{ path('culture_edit', {'id': culture.id}) }}" class="btn btn-warning shadow-sm me-3">
                <i class="fas fa-edit"></i> Modifier
            </a>
            <form action="{{ path('culture_delete', {'id': culture.id}) }}" method="POST" class="d-inline" onsubmit="return confirm('Voulez-vous vraiment supprimer cette culture ?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ culture.id) }}">
                <button class="btn btn-danger shadow-sm me-3" type="submit">
                    <i class="fas fa-trash-alt"></i> Supprimer
                </button>
            </form>
            <a href="{{ path('app_culture_index') }}" class="btn btn-secondary shadow-sm">
                <i class="fas fa-arrow-left"></i> Retour à la liste
            </a>
        </div>
    </div>

    <style>
        body {
            background-color: #f4f7fa;
        }

        h1 {
            font-size: 2.5rem;
            font-weight: 700;
            color: #28a745;
        }

        .card {
            border-radius: 12px;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
        }

        .card-body {
            font-size: 1.1rem;
        }

        .card-title {
            font-size: 1.25rem;
            font-weight: 600;
            margin-bottom: 20px;
        }

        .parcelle-image img {
            border-radius: 10px;
            object-fit: cover;
            max-height: 400px;
            width: 100%;
            transition: transform 0.3s ease;
        }

        .parcelle-image img:hover {
            transform: scale(1.05);
        }

        .btn {
            font-size: 1rem;
            padding: 10px 20px;
            border-radius: 8px;
            transition: transform 0.2s ease;
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        }

        .btn-warning {
            background-color: #ffc107;
            border: none;
        }

        .btn-warning:hover {
            background-color: #e0a800;
        }

        .btn-danger {
            background-color: #dc3545;
            border: none;
        }

        .btn-danger:hover {
            background-color: #c82333;
        }

        .btn-secondary {
            background-color: #6c757d;
            border: none;
        }

        .btn-secondary:hover {
            background-color: #5a6268;
        }

        .text-center {
            text-align: center;
        }

        .me-3 {
            margin-right: 10px;
        }

        .shadow-sm {
            box-shadow: 0px 2px 5px rgba(0, 0, 0, 0.15);
        }
    </style>
{% endblock %}
