<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Détails de la Culture</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 20px; }
        h1 { color: #28a745; text-align: center; }
        .container { width: 100%; padding: 20px; border: 1px solid #ddd; border-radius: 10px; }
        p { font-size: 14px; }
        .info { margin-bottom: 10px; }
    </style>
</head>
<body>
    <h1>{{ culture.nom }}</h1>
    <div class="container">
        <p class="info"><strong>Description :</strong> {{ culture.description }}</p>
        <p class="info"><strong>Date de plantation :</strong> {{ culture.datePlantation|date('d/m/Y') }}</p>
        <p class="info"><strong>Date de récolte :</strong> {{ culture.dateRecolte|date('d/m/Y') }}</p>
        <p class="info"><strong>Quantité :</strong> {{ culture.quantite }} KG</p>
        <p class="info"><strong>Catégorie :</strong> {{ culture.categorie }}</p>
    </div>
</body>
</html>
