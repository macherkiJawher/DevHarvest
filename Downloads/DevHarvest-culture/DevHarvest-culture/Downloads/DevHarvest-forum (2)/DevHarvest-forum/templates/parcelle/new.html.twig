{% extends 'client.html.twig' %}

{% block title %}Ajouter une Parcelle{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h1 class="text-center text-success mb-4">🌿 Ajouter une parcelle</h1>

        {{ form_start(form, {'attr': {'class': 'parcelle-form'}}) }}

        <div class="row justify-content-center">
            <div class="col-lg-8 col-md-10 col-sm-12">
                <div class="card shadow-lg border-0">
                    <div class="card-body p-4">

                        <!-- Section du champ de la zone de la parcelle -->
                        <div class="row mb-4">
                            <div class="col-md-12">
                                <label for="{{ form.zone.vars.id }}" class="form-label fw-bold">🌍 Zone de la parcelle</label>
                                {{ form_widget(form.zone, {
                                    'attr': {'class': 'form-control', 'placeholder': 'Entrez la zone de la parcelle'}
                                }) }}
                                {{ form_errors(form.zone) }}
                            </div>
                        </div>

                        <!-- Section de la description de la parcelle -->
                        <div class="row mb-4">
                            <div class="col-md-12">
                                <label for="{{ form.description.vars.id }}" class="form-label fw-bold">📝 Description de la parcelle</label>
                                {{ form_widget(form.description, {
                                    'attr': {'class': 'form-control', 'placeholder': 'Entrez une description de la parcelle'}
                                }) }}
                                {{ form_errors(form.description) }}
                            </div>
                        </div>

                        <!-- Section de la superficie et prix de location -->
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label for="{{ form.superficie.vars.id }}" class="form-label fw-bold">📏 Superficie (m²)</label>
                                {{ form_widget(form.superficie, {
                                    'attr': {'class': 'form-control', 'placeholder': 'Superficie en m²'}
                                }) }}
                                {{ form_errors(form.superficie) }}
                            </div>
                            <div class="col-md-6">
                                <label for="{{ form.prix_de_location.vars.id }}" class="form-label fw-bold">💰 Prix de location (TND)</label>
                                {{ form_widget(form.prix_de_location, {
                                    'attr': {'class': 'form-control', 'placeholder': 'Prix de location en TND'}
                                }) }}
                                {{ form_errors(form.prix_de_location) }}
                            </div>
                        </div>

                        <!-- Section des dates de location -->
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label for="{{ form.date_de_location.vars.id }}" class="form-label fw-bold">📅 Date de location</label>
                                {{ form_widget(form.date_de_location, {
                                    'attr': {'class': 'form-control', 'placeholder': 'Sélectionnez la date de location'}
                                }) }}
                                {{ form_errors(form.date_de_location) }}
                            </div>
                            <div class="col-md-6">
                                <label for="{{ form.date_de_fin_location.vars.id }}" class="form-label fw-bold">📅 Date de fin de location</label>
                                {{ form_widget(form.date_de_fin_location, {
                                    'attr': {'class': 'form-control', 'placeholder': 'Sélectionnez la date de fin de location'}
                                }) }}
                                {{ form_errors(form.date_de_fin_location) }}
                            </div>
                        </div>

                        <!-- Section de l'état et type de sol -->
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label for="{{ form.etat.vars.id }}" class="form-label fw-bold">🌿 État de la parcelle</label>
                                {{ form_widget(form.etat, {
                                    'attr': {'class': 'form-control', 'placeholder': 'Indiquez l\'état de la parcelle'}
                                }) }}
                                {{ form_errors(form.etat) }}
                            </div>
                            <div class="col-md-6">
                                <label for="{{ form.type_sol.vars.id }}" class="form-label fw-bold">🌱 Type de sol</label>
                                {{ form_widget(form.type_sol, {
                                    'attr': {'class': 'form-control'}
                                }) }}
                                {{ form_errors(form.type_sol) }}
                            </div>
                        </div>

                        <!-- Section de l'image de la parcelle -->
                        <div class="mb-4">
                            <label for="{{ form.image.vars.id }}" class="form-label fw-bold">🖼️ Image de la parcelle (jpeg, png, gif)</label>
                            {{ form_widget(form.image, {
                                'attr': {'class': 'form-control-file'}
                            }) }}
                            {{ form_errors(form.image) }}
                        </div>

                        <hr>

                        <!-- Section des boutons -->
                        <div class="text-center">
                            <button class="btn btn-success btn-lg shadow-sm me-2" type="submit">
                                <i class="fas fa-check"></i> Soumettre
                            </button>
                            <a href="{{ path('parcelle_index') }}" class="btn btn-danger btn-lg shadow-sm">
                                <i class="fas fa-times"></i> Annuler
                            </a>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        {{ form_end(form) }}
    </div>

    <style>
        body {
            background-color: #f8f9fa;
        }

        .card {
            border-radius: 12px;
            overflow: hidden;
            transition: transform 0.2s ease-in-out;
        }

        .card:hover {
            transform: scale(1.02);
        }

        .form-label {
            font-size: 1rem;
            color: #555;
        }

        .form-control {
            border-radius: 8px;
            border: 1px solid #ccc;
            padding: 10px;
            font-size: 1rem;
            transition: all 0.3s ease-in-out;
        }

        .form-control:focus {
            border-color: #28a745;
            box-shadow: 0 0 10px rgba(40, 167, 69, 0.2);
        }

        .btn-lg {
            font-size: 1.1rem;
            padding: 12px 18px;
            border-radius: 8px;
            transition: all 0.3s ease-in-out;
        }

        .btn:hover {
            transform: translateY(-2px);
        }
    </style>

{% endblock %}
