{% extends 'admin.html.twig' %}

{% block title %}Gestion des Cultures{% endblock %}

{% block content %}
<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="text-dark">Liste des Cultures</h1>
        <a href="{{ path('admin_culture_new') }}" class="btn btn-success">
            <i class="fas fa-plus"></i> Ajouter une Culture
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover shadow-sm bg-white rounded">
            <thead class="table-dark text-white">
                <tr>
                    <th>Nom</th>
                    <th>Description</th>
                    <th>Date de Plantation</th>
                    <th>Date de Récolte</th>
                    <th>Image</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for culture in cultures %}
                    <tr>
                        <td>{{ culture.nom }}</td>
                        <td>{{ culture.description }}</td>
                        <td>{{ culture.datePlantation ? culture.datePlantation|date('d/m/Y') : 'N/A' }}</td>
                        <td>{{ culture.dateRecolte ? culture.dateRecolte|date('d/m/Y') : 'N/A' }}</td>
                        <td>
                            {% if culture.image %}
                                <img src="{{ asset('uploads/images/' ~ culture.image) }}" alt="{{ culture.nom }}" class="img-thumbnail" width="50">
                            {% else %}
                                Aucune image
                            {% endif %}
                        </td>
                        <td class="text-center">
                            <a href="{{ path('admin_culture_edit', {'id': culture.id}) }}" class="btn btn-outline-primary btn-sm">
                                <i class="fas fa-edit"></i> Modifier
                            </a>
                            <form method="post" action="{{ path('admin_culture_delete', {'id': culture.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette culture ?');" class="d-inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ culture.id) }}">
                                <button class="btn btn-outline-danger btn-sm">
                                    <i class="fas fa-trash"></i> Supprimer
                                </button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">Aucune culture trouvée.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<div class="text-center mt-4">
    <a href="{{ path('admin_dashboard') }}" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left"></i> Retour au tableau de bord
    </a>
</div>

{% endblock %}
