{% extends 'client.html.twig' %}

{% block title %}Liste des Cultures{% endblock %}

{% block body %}
    <h1 class="text-center my-4">Liste des Cultures</h1>
<div class="container">
    <div class="row">
        <div class="col-12 text-center">
            <a href="{{ path('culture_new') }}" class="btn btn-success">
                Ajouter une nouvelle culture
            </a>
        </div>
    </div>
</div>


    <div class="container">
        <div class="row">
            {% for culture in cultures %}
                <div class="col-md-4 mb-4">
                    <div class="card shadow-sm">
                        <div class="image-container">
                            {% if culture.image %}
                                <img src="{{ asset('uploads/images/' ~ culture.image) }}" class="card-img-top" alt="{{ culture.nom }}">
                            {% else %}
                                <img src="{{ asset('images/default.jpg') }}" class="card-img-top" alt="Image par défaut">
                            {% endif %}
                        </div>
                        <div class="card-body text-center">
                            <h5 class="card-title">
                                <a href="{{ path('culture_show', {'id': culture.id}) }}" class="text-primary">{{ culture.nom }}</a>
                            </h5>
                            <p class="card-text">{{ culture.description|slice(0, 50) ~ '...' }}</p>
                            <p class="mb-2"><strong>Plantation:</strong> {{ culture.datePlantation ? culture.datePlantation|date('d/m/Y') : 'Non définie' }}</p>
                            <p class="mb-4"><strong>Récolte:</strong> {{ culture.dateRecolte ? culture.dateRecolte|date('d/m/Y') : 'Non définie' }}</p>

                            <div class="d-flex justify-content-between">
                                <a href="{{ path('culture_show', {'id': culture.id}) }}" class="btn btn-info btn-sm w-100 me-2 mb-2">
                                    <i class="fas fa-eye"></i> Voir
                                </a>
                                <a href="{{ path('culture_edit', {'id': culture.id}) }}" class="btn btn-warning btn-sm w-100 me-2 mb-2">
                                    <i class="fas fa-edit"></i> Modifier
                                </a>
                                <form method="post" action="{{ path('culture_delete', {'id': culture.id}) }}" onsubmit="return confirm('Voulez-vous vraiment supprimer cette culture ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ culture.id) }}">
                                    <button class="btn btn-danger btn-sm w-100 mb-2" type="submit">
                                        <i class="fas fa-trash-alt"></i> Supprimer
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12 text-center">
                    <p>Aucune culture enregistrée.</p>
                </div>
            {% endfor %}
        </div>
    </div>

    <style>
        .card-img-top {
            height: 200px; /* Fixe la hauteur de l'image */
            object-fit: cover; /* Assure que l'image est bien adaptée à la taille sans déformation */
        }

        .image-container {
            overflow: hidden; /* Cache tout excédent de l'image qui dépasse */
        }

        .card {
            margin-bottom: 20px;
            border-radius: 10px; /* Optionnel : coins arrondis pour un effet moderne */
        }

        .card-body {
            padding: 20px;
        }

        .card-title a {
            font-size: 1.25rem;
            font-weight: bold;
            text-decoration: none;
        }

        .card-title a:hover {
            text-decoration: underline;
        }

        .btn {
            font-size: 1rem;
            padding: 10px 10px;
            border-radius: 5px;
            transition: all 0.3s ease;
        }

        .btn:hover {
            transform: translateY(-2px);
        }

        .w-100 {
            width: 30%; /* Fixe la largeur des boutons à 30% */
        }

        .me-2 {
            margin-right: 10px; /* Ajoute de l'espace entre les boutons */
        }

        .mb-2 {
            margin-bottom: 10px; /* Ajoute un petit espacement entre les boutons */
        }

        .mb-4 {
            margin-bottom: 20px;
        }

        .d-flex {
            flex-direction: row; /* Aligne les boutons horizontalement */
        }

        .d-flex a, .d-flex button {
            flex-grow: 1; /* Les boutons prennent la même largeur */
        }
    </style>
{% endblock %}
